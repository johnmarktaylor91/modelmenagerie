    {
      "stage": "author:source-request-guard",
      "lane": "author",
      "dispatch_kind": "author_source",
      "guard": "source-request",
      "injection": "MENAGERIE_DRY_RUN_INJECT_SESSION_DEATH + MENAGERIE_DRY_RUN_INJECT_SESSION_DEATH_STAGE=source-request",
      "fired_by": [
        "menagerie/crawler/tests/test_post_reserve_failability.py::test_source_guard_session_death_fires_post_reserve"
      ]
    },
    {
      "stage": "author:author-guard",
      "lane": "author",
      "dispatch_kind": "author_source",
      "guard": "author",
      "injection": "MENAGERIE_DRY_RUN_INJECT_SESSION_DEATH",
      "fired_by": [
        "menagerie/crawler/tests/test_session_death_dry_run_rehearsal.py::test_session_death_injection_dies_on_the_classified_transport_path"
      ]
    },
    {
      "stage": "checker:metadata_batch",
      "lane": "checker",
      "dispatch_kind": "metadata_batch",
      "guard": "checker",
      "injection": "MENAGERIE_DRY_RUN_INJECT_CHECKER_SESSION_DEATH",
      "fired_by": [
        "menagerie/crawler/tests/test_post_reserve_failability.py::test_checker_session_death_fires_post_reserve[metadata_batch]"
      ]
    },
    {
      "stage": "checker:fidelity",
      "lane": "checker",
      "dispatch_kind": "fidelity",
      "guard": "checker",
      "injection": "MENAGERIE_DRY_RUN_INJECT_CHECKER_SESSION_DEATH",
      "fired_by": [
        "menagerie/crawler/tests/test_post_reserve_failability.py::test_checker_session_death_fires_post_reserve[fidelity]"
      ]
    },
    {
      "stage": "checker:terminal_disposition",
      "lane": "checker",
      "dispatch_kind": "terminal_disposition",
      "guard": "checker",
      "injection": "MENAGERIE_DRY_RUN_INJECT_CHECKER_SESSION_DEATH",
      "fired_by": [
        "menagerie/crawler/tests/test_post_reserve_failability.py::test_checker_session_death_fires_post_reserve[terminal_disposition]"
      ]
    }
  ]
