---
import { findDefaultVariant, getStandInShareCount, type ModelRecord } from "@/lib/catalog";
import { cardDataFromRecord, renderCardHtml } from "@/scripts/CardView";

interface Props {
  model: ModelRecord;
  headingLevel?: 2 | 3;
}

const { model, headingLevel = 2 } = Astro.props;
// One renderer for build-time and filtered cards; see src/scripts/CardView.ts.
const standIn = getStandInShareCount(findDefaultVariant(model)) > 0;
const html = renderCardHtml(cardDataFromRecord(model, standIn), { headingLevel });
---

<Fragment set:html={html} />

<style is:global>
  /* Global because the client listing renders the same markup at runtime. */
  .model-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    transition: border-color 150ms ease;
  }

  .model-card:hover,
  .model-card:focus-within {
    border-color: color-mix(in srgb, var(--accent) 65%, var(--border));
  }

  .model-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  .model-card__link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  /* Show the top of the graph in a fixed 4:3 box at its own aspect ratio: tall graphs are
     clipped at the bottom with a fade, short ones sit centred; nothing is stretched or
     side-cropped, and the box keeps its size while the picture loads. */
  .model-card__frame {
    position: relative;
    display: flex;
    flex: none;
    flex-direction: column;
    justify-content: flex-start;
    justify-content: safe center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--diagram-paper);
  }

  /* The fade ends in paper white, so in dark mode the preview stays a white sheet instead of dimming. */
  .model-card__frame::after {
    position: absolute;
    inset: auto 0 0;
    height: 20%;
    background: linear-gradient(to bottom, transparent, var(--diagram-paper));
    content: "";
    pointer-events: none;
  }

  .model-card__frame img {
    display: block;
    flex: none;
    width: 100%;
    max-width: none;
    height: auto;
  }

  /* A real top crop (800 by 600) fills the box, anchored at the top of the graph. */
  .model-card__frame--crop img {
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* A text card has no picture: its empty frame appears only as the list view's placeholder. */
  .model-card__frame--empty {
    display: none;
    background: var(--surface-2);
  }

  .model-card__frame--empty::after {
    content: none;
  }

  .model-card--text {
    background: color-mix(in srgb, var(--surface) 70%, transparent);
  }

  .model-card--text .model-card__body {
    justify-content: center;
    border-top: 0;
  }

  .model-card__no-preview {
    margin: 0;
    color: var(--secondary);
    font-size: 0.75rem;
  }

  .model-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.85rem 1rem 1rem;
    border-top: 1px solid var(--border);
  }

  /* Card titles keep the body face whatever their heading level. */
  .model-card__title {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .model-card__facts {
    margin: 0;
    color: var(--secondary);
    font-size: 0.85rem;
  }

  /* A dot between the facts that are present; unknown facts are empty and take no separator. */
  .model-card__fact:empty {
    display: none;
  }

  .model-card__fact:not(:empty) ~ .model-card__fact:not(:empty)::before {
    content: "\00a0\00b7\0020";
    content: "\00a0\00b7\0020" / "";
  }

  .model-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .model-card__chip {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--secondary);
    font-size: 0.75rem;
  }

  .model-card__chip--verified {
    border-color: var(--verified);
    color: var(--verified);
  }
</style>
