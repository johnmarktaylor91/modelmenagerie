---
/**
 * A mailto link that Cloudflare's email obfuscation leaves alone. BaseLayout wraps <main> in the `email_off`
 * markers (markers do not nest, so this component adds none); without them the edge rewrites the link to
 * /cdn-cgi/l/email-protection and adds a decoding script to the page.
 */
interface Props {
  email: string;
}

const { email } = Astro.props;
const safe = email.replace(/[<>&"]/g, "");
---

<a class="textlink" href={`mailto:${safe}`}>{safe}</a>
