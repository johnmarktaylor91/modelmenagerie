---
import CopyCode from "@/components/CopyCode.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getManifest } from "@/lib/catalog";
import { checkedByVersion, getSiteCounts } from "@/lib/counts";
import { datasetColumns, datasetFiles, exportDate, formatDate, pythonExample } from "@/lib/dataset";
import { shareImagePath } from "@/lib/seo";
import { CONTENT_LICENCE, CREATOR, SITE_NAME, SITE_URL, TORCHLENS, TORCHLENS_BIBTEX, releaseVersion, siteBibtex, siteCitation } from "@/lib/site";

const manifest = getManifest();
const number = new Intl.NumberFormat("en");
const megabytes = new Intl.NumberFormat("en", { maximumFractionDigits: 1 });

const version = releaseVersion(manifest.export_version);
const asOf = exportDate();
const year = asOf ? Number(asOf.slice(0, 4)) : new Date().getUTCFullYear();

/** Human file size, e.g. "7.8 MB". */
function formatBytes(bytes: number): string {
  return bytes >= 1_000_000 ? `${megabytes.format(bytes / 1_000_000)} MB` : `${Math.max(1, Math.round(bytes / 1000))} KB`;
}

const downloads = datasetFiles().map((item) => ({ ...item, size: formatBytes(item.bytes) }));
const columns = datasetColumns();

// Every count comes from the export's funnel and manifest, dated by its as_of.
const siteCounts = getSiteCounts();
const modelCount = manifest.counts.models ?? siteCounts.validated;
const counts = [
  { label: "Models with a checked diagram", value: siteCounts.validated, key: "validated" },
  { label: "Graph structure only", value: siteCounts.structureOnly, key: "structure" },
  { label: "Distinct architectures", value: siteCounts.distinctArchitectures },
  { label: "Entries in the catalog", value: siteCounts.rosterNames, key: "roster" },
].filter((item): item is { label: string; value: number; key?: string } => (item.value ?? 0) > 0);
const hasStates = siteCounts.structureOnly !== null;

const pandasExample = pythonExample(datasetFiles(), SITE_URL);
const hasRecordsFile = downloads.some((item) => item.file.startsWith("models.jsonl"));
const versions = checkedByVersion();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: `${SITE_NAME} catalog`,
  description:
    "One record per neural network in Model Menagerie: name, task, architecture family and operation count, with links to its TorchLens computational graph diagrams and their checksums.",
  url: new URL("/dataset/", SITE_URL).href,
  ...(version ? { version } : {}),
  ...(asOf ? { dateModified: asOf } : {}),
  license: CONTENT_LICENCE.url,
  isAccessibleForFree: true,
  creator: { "@type": "Person", name: CREATOR.name, url: CREATOR.url },
  keywords: ["neural networks", "computational graphs", "model architectures", "PyTorch", "TorchLens"],
  measurementTechnique: "TorchLens tracing of each model's forward pass",
  citation: siteCitation(year, version),
  variableMeasured: columns.filter((column) => !column.jsonlOnly).map((column) => column.name),
  distribution: downloads
    .filter((item) => item.file !== "export_manifest.json")
    .map((item) => ({
      "@type": "DataDownload",
      encodingFormat: item.format,
      contentUrl: new URL(item.href, SITE_URL).href,
      contentSize: `${item.bytes} B`,
    })),
};
---

<BaseLayout
  title="Dataset"
  description={`Download the Model Menagerie catalog as CSV or JSON Lines: ${number.format(modelCount)} models, each with links to its TorchLens diagrams. Free to reuse under CC BY 4.0.`}
  ogImage={shareImagePath("dataset")}
  ogImageAlt={`The ${SITE_NAME} dataset: one record per model, with every diagram file`}
  jsonLd={jsonLd}
>
  <article class="shell dataset py-10">
    {version && <p class="chip mb-3">Release {version}</p>}
    <h1 class="text-3xl font-semibold sm:text-4xl">Dataset</h1>
    <p class="lead mt-4 text-secondary">
      The CSV has one row for each of the {number.format(modelCount)} models with a diagram: its name, task, family,
      operation count and how it was checked.{hasRecordsFile && (
        <> The JSON Lines file has each model's full record, with the address, checksum and size of every diagram file.</>
      )}
    </p>

    {
      downloads.length > 0 && (
        <ul class="downloads mt-6" aria-label="Downloads">
          {downloads.map((item) => (
            <li>
              <a class:list={["button", { primary: item.primary }]} href={item.href} download={item.saveAs}>
                {item.label}
                <span class="size">{item.size}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <section aria-labelledby="contents">
      <h2 id="contents">This release</h2>
      <dl class="counts">
        {
          counts.map((item) => (
            <div>
              <dt class="text-secondary">{item.label}</dt>
              <dd data-count={item.key}>{number.format(item.value)}</dd>
            </div>
          ))
        }
        {
          asOf && (
            <div>
              <dt class="text-secondary">Counts as of</dt>
              <dd>
                <time datetime={asOf}>{formatDate(asOf)}</time>
              </dd>
            </div>
          )
        }
      </dl>
      <p class="text-secondary">
        {
          hasStates ? (
            <>
              Each record is a model built from its published code, then traced and drawn with TorchLens. A checked record
              was replayed operation by operation and passed its check; a structure-only record has the graph's structure
              without that check. The{" "}
              <code>validation_state</code> column says which.{versions.length > 1 && (
                <> Checked records by TorchLens version: {new Intl.ListFormat("en", { type: "conjunction" }).format(versions.map((row) => `${number.format(row.checked)} with ${row.version}`))}; the{" "}
                <code>torchlens_version</code> column gives each record's version.</>
              )} The catalog's entry count includes every model collected so far, drawn or not; models without a diagram
              are not in these files.
            </>
          ) : (
            "Each record is a model built from its published code, then traced and drawn with TorchLens. Source, license and paper details fill in with later releases."
          )
        }
        {" "}
        <a class="textlink" href="/changelog/">What changed in each release</a>.
      </p>
    </section>

    <section aria-labelledby="python">
      <h2 id="python">Load it in Python</h2>
      {pandasExample && <CopyCode code={pandasExample} label="Copy the Python example" name="Python example" />}
    </section>

    <section aria-labelledby="fields">
      <h2 id="fields">Columns</h2>
      <p class="text-secondary">
        The CSV has one row per model and no diagram files.{hasRecordsFile && " The JSON Lines file has the same fields, plus the ones marked JSON Lines only."}
        Empty means not recorded yet.
      </p>
      <details class="panel mt-3">
        <summary>Show all {columns.length} columns</summary>
        <dl class="fields">
          {
            columns.map((column) => (
              <div>
                <dt class="mono">
                  {column.name}
                  {column.jsonlOnly && <span class="only">JSON Lines only</span>}
                </dt>
                <dd class="text-secondary">{column.description}</dd>
              </div>
            ))
          }
        </dl>
      </details>
    </section>

    <section aria-labelledby="license">
      <h2 id="license">License and reuse</h2>
      <p>
        The dataset, the diagrams and the site's text are free to reuse under
        <a class="textlink" href={CONTENT_LICENCE.url} rel="license">{CONTENT_LICENCE.name} ({CONTENT_LICENCE.short})</a>:
        share and adapt them, with credit to the {SITE_NAME}.
      </p>
      <p class="mt-3">
        Each diagram is this site's drawing of a trace of a model's code. It is not the code or the weights, which stay
        under their own licenses; the <span class="mono">source_license</span> column gives the code's license where it is
        recorded. More on the <a class="textlink" href="/legal/">privacy and licenses page</a>.
      </p>
    </section>

    <section aria-labelledby="cite">
      <h2 id="cite">How to cite</h2>
      <p class="text-secondary">Please cite the dataset and TorchLens, which made every diagram in it.</p>
      <p class="citation panel mt-3">{siteCitation(year, version)}</p>
      <div class="mt-3">
        <CopyCode code={siteBibtex(year, version)} label="Copy the BibTeX entry for the dataset" name="BibTeX for the dataset" />
      </div>
      <div class="mt-3">
        <CopyCode code={TORCHLENS_BIBTEX} label="Copy the BibTeX entry for TorchLens" name="BibTeX for TorchLens" />
      </div>
      <p class="mt-3 text-secondary">
        TorchLens: <a class="textlink" href={TORCHLENS.paper}>Taylor and Kriegeskorte, Scientific Reports 13, 14375 (2023)</a>.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .dataset {
    max-width: 52rem;
  }

  .dataset .lead {
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .dataset section {
    margin-top: 2.5rem;
  }

  .dataset h2 {
    margin-bottom: 0.75rem;
    font-size: 1.375rem;
    font-weight: 600;
  }

  .downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }

  .downloads .size {
    font-weight: 400;
  }

  .counts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 0 0 1rem;
  }

  .counts dt {
    font-size: 0.875rem;
  }

  .counts dd {
    margin: 0.15rem 0 0;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .dataset p {
    line-height: 1.7;
  }

  .citation {
    padding: 1rem;
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }

  details {
    min-width: 0;
  }

  summary {
    padding: 0.85rem 1rem;
    font-weight: 600;
    cursor: pointer;
  }

  .fields {
    margin: 0;
    padding: 0 1rem 0.5rem;
  }

  .fields div {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding-block: 0.7rem;
    border-top: 1px solid var(--border);
  }

  .fields dt {
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }

  .fields .only {
    display: block;
    margin-top: 0.15rem;
    color: var(--secondary);
    font-family: var(--font-body);
    font-size: 0.75rem;
  }

  .fields dd {
    margin: 0;
  }

  @media (max-width: 39.99rem) {
    .fields div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
