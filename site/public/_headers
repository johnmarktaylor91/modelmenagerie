# Cloudflare Pages response headers. HTML keeps the Pages default (max-age=0, must-revalidate):
# every visit revalidates, so a new deploy is seen at once and never references missing hashed files.
# Do not add a second Cache-Control rule matching the same path: Pages joins duplicate values.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Content-hashed build output: the name changes whenever the bytes do.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Search index and the listing's picture keys: fresh for 5 minutes, then served at once and
# revalidated in the background for a day, so a returning visitor's search starts without waiting.
/models-index.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/models-thumbs.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/favicon.ico
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
# Share images (built from src/pages/og/): fetched by link previews, which cache them themselves.
/og/*
  Cache-Control: public, max-age=86400

# Dataset downloads save as files instead of opening as text in the tab.
/dataset/catalog.csv
  Content-Disposition: attachment; filename="model-menagerie-catalog.csv"
  Cache-Control: public, max-age=3600
/dataset/models.jsonl
  Content-Disposition: attachment; filename="model-menagerie-models.jsonl"
  Cache-Control: public, max-age=3600
/dataset/export_manifest.json
  Cache-Control: public, max-age=3600
